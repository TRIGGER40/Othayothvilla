# Copy to .env.local and set a strong secret before running the guest portal.
# Used to HMAC-sign the stay-only guest session cookie. Minimum 32 bytes.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
GUEST_SESSION_SECRET=replace-with-a-long-random-secret-value

# Public site URL (used for absolute links / magic-link generation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
